{
  "version": 3,
  "configurePresets": [
    {
      "name": "macos-debug",
      "displayName": "SmartPark macOS + Server Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SMARTPARK_BUILD_MACOS_ADMIN": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "server-debug",
      "displayName": "SmartPark Server + Terminals Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/server",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SMARTPARK_BUILD_MACOS_ADMIN": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "server-release",
      "displayName": "SmartPark s1 Deployment",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/server-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SMARTPARK_BUILD_MACOS_ADMIN": "OFF",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "server-debug", "configurePreset": "server-debug" },
    { "name": "server-release", "configurePreset": "server-release" }
  ],
  "testPresets": [
    {
      "name": "macos-tests",
      "configurePreset": "macos-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "server-tests",
      "configurePreset": "server-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
